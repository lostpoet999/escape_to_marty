metadata/_custom_type_script = "uid://da86xmy7akvas"

[sub_resource type="Resource" id="Resource_kx5gr"]
script = ExtResource("1_gqrx6")
speaker = 1
text = "Try harder--you might just finish me off and escape!"
central_image_glow_points = null
metadata/_custom_type_script = "uid://da86xmy7akvas"

[sub_resource type="Resource" id="Resource_fp1aj"]
script = ExtResource("1_gqrx6")
speaker = 1
text = "I don't think you're angry enough!"
central_image_glow_points = null
metadata/_custom_type_script = "uid://da86xmy7akvas"

[sub_resource type="Resource" id="Resource_3mo7q"]
script = ExtResource("1_gqrx6")
speaker = 1
text = "Let's make a deal--pay me more gold and maybe I will let you leave!"
central_image_glow_points = null
metadata/_custom_type_script = "uid://da86xmy7akvas"

[sub_resource type="Resource" id="Resource_q0rro"]
script = ExtResource("1_gqrx6")
speaker = 1
text = "Face it!  You can't win!"
