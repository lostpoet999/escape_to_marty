[ext_resource type="Texture2D" uid="uid://bau6b5huhps3y" path="res://scenes_and_scripts/dialog/story portraits/JESSICA.png" id="4_5f6jq"]
[ext_resource type="Script" uid="uid://bkgp0oq7lrafl" path="res://scenes_and_scripts/dialog/dialog_tree.gd" id="5_f0aok"]
[ext_resource type="Texture2D" uid="uid://dalichhj1x6jc" path="res://scenes_and_scripts/dialog/story portraits/MARTY.png" id="6_marty"]
[ext_resource type="Texture2D" uid="uid://chc2wj2a1yn78" path="res://scenes_and_scripts/dialog/story portraits/FAMILY.png" id="7_family"]

[sub_resource type="Resource" id="Resource_beat_1"]
script = ExtResource("1_thhwg")
text = "Jess...Marty"
portrait = ExtResource("2_1ox6p")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_2"]
script = ExtResource("1_thhwg")
text = "Mommy...Daddy...I want my family back."
portrait = ExtResource("3_8451t")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_3"]
script = ExtResource("1_thhwg")
speaker = 4
text = "David?"
portrait = ExtResource("4_5f6jq")
portrait_side = 1
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_4"]
script = ExtResource("1_thhwg")
text = "JESS! Mom--I...we missed you so much!"
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_5"]
script = ExtResource("1_thhwg")
speaker = 4
text = "David. You've endured so much and traveled so far."
portrait_side = 1
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_6"]
script = ExtResource("1_thhwg")
text = "I can't stay, I'm sorry. I have to get back to Marty. He needs me."
central_image = ExtResource("6_marty")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_7"]
script = ExtResource("1_thhwg")
speaker = 4
text = "You were always so protective of him, but you can't go back.  You have already accepted this.  You still live in his heart and provide him strength...we both do."
portrait_side = 1
central_image = ExtResource("6_marty")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_8"]
script = ExtResource("1_thhwg")
text = "I..."
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_9"]
script = ExtResource("1_thhwg")
text = "I know.  He is there, we are here.  He has to live until it is his time...but no matter what..."
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_10"]
script = ExtResource("1_thhwg")
text = "We ARE family."
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_11"]
script = ExtResource("1_thhwg")
speaker = 4
text = "That's right.  You make me proud--let's go when you are ready."
portrait_side = 1
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_12"]
script = ExtResource("1_thhwg")
text = "Be strong daddy, I will take care of her."
central_image = ExtResource("3_8451t")
central_image_glow_points = null
reveal_speed_scale = 0.3
music_pitch_scale = 1.0
clears_portraits = true

[sub_resource type="Resource" id="Resource_beat_13"]
script = ExtResource("1_thhwg")
text = "End."
central_image = ExtResource("7_family")
central_image_entrance_seconds = 0.6
central_image_entrance_rotation_deg = -7.0
central_image_glow_points = null

