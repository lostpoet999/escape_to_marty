script = ExtResource("5_f0aok")
beats = Array[ExtResource("1_thhwg")]([SubResource("Resource_beat_1"), SubResource("Resource_beat_2"), SubResource("Resource_beat_3"), SubResource("Resource_beat_4"), SubResource("Resource_beat_5"), SubResource("Resource_beat_6"), SubResource("Resource_beat_7"), SubResource("Resource_beat_8"), SubResource("Resource_beat_9"), SubResource("Resource_beat_10"), SubResource("Resource_beat_11"), SubResource("Resource_beat_12"), SubResource("Resource_beat_13")])
