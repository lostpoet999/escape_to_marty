[sub_resource type="Resource" id="Resource_beat_1"]
script = ExtResource("2_beat")
speaker = 10
text = "Sorry to rush past you my guy. I have to get flowers for Mother's Day."
portrait = ExtResource("4_stranger")
portrait_side = 1
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_2"]
script = ExtResource("2_beat")
text = "HEY!  I don't CARE what you are in a rush for.  Watch where you are going and think about what you say in front of people!"
portrait = ExtResource("5_md")
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_3"]
script = ExtResource("2_beat")
speaker = 6
text = "Marty. He can't hear you with those headphones. You can't just yell at everyone like that."
portrait = ExtResource("6_grandpa")
portrait_side = 1
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_4"]
script = ExtResource("2_beat")
text = "They're just walking around like nothing is wrong.  He is a jerk."
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_5"]
script = ExtResource("2_beat")
speaker = 6
text = "I know you miss her. We all do."
portrait_side = 1
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_6"]
script = ExtResource("2_beat")
text = "It still hurts so much."
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_7"]
script = ExtResource("2_beat")
speaker = 6
text = "She's in a better place now."
portrait_side = 1
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_8"]
script = ExtResource("2_beat")
text = "A better place?! What's better than being with us?"
central_image = ExtResource("3_icon")
central_image_glow_points = null

[resource]
script = ExtResource("1_tree")
beats = Array[ExtResource("2_beat")]([SubResource("Resource_beat_1"), SubResource("Resource_beat_2"), SubResource("Resource_beat_3"), SubResource("Resource_beat_4"), SubResource("Resource_beat_5"), SubResource("Resource_beat_6"), SubResource("Resource_beat_7"), SubResource("Resource_beat_8")])
