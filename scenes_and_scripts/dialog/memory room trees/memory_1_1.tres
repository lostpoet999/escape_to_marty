[sub_resource type="Resource" id="Resource_beat_1"]
script = ExtResource("2_beat")
text = "Lots of adoptions today.  I'm just nervous about one."
portrait = ExtResource("4_md")
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_2"]
script = ExtResource("2_beat")
speaker = 4
text = "Settle down sweetheart, he'll love you."
portrait = ExtResource("5_jess")
portrait_side = 1
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_3"]
script = ExtResource("2_beat")
text = "I'm your teddy bear."
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_4"]
script = ExtResource("2_beat")
speaker = 4
text = "Our teddy bear needs a hug on this big day."
portrait_side = 1
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_5"]
script = ExtResource("2_beat")
text = "What if he changes his mind about me?  I know the fastest way out of here."
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_6"]
script = ExtResource("2_beat")
speaker = 4
text = "Were you a teddy bear or a gummy bear  Relax, this is the best gift ever."
portrait_side = 1
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_7"]
script = ExtResource("2_beat")
speaker = 5
text = "Thanks for all of your patience, here we are with the paperwork, it's official--you're a family! Congratulations!"
portrait = ExtResource("6_officer")
portrait_side = 1
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_8"]
script = ExtResource("2_beat")
speaker = 4
text = "It's been a long day. The sooner we get home the sooner everything will gel. Sound good?"
portrait = ExtResource("5_jess")
portrait_side = 1
central_image = ExtResource("3_icon")
central_image_glow_points = null

[sub_resource type="Resource" id="Resource_beat_9"]
script = ExtResource("2_beat")
text = "Yep."
central_image = ExtResource("3_icon")
central_image_glow_points = null

