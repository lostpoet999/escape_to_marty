[ext_resource type="Script" uid="uid://bkgp0oq7lrafl" path="res://scenes_and_scripts/dialog/dialog_tree.gd" id="1_tree"]
[ext_resource type="Script" uid="uid://da86xmy7akvas" path="res://scenes_and_scripts/dialog/dialog_beat.gd" id="2_beat"]
[ext_resource type="Texture2D" uid="uid://co3m5jtpavhq2" path="res://scenes_and_scripts/dialog/story icons/gravestone.png" id="3_icon"]
[ext_resource type="Texture2D" uid="uid://b4g0os6q6xuwm" path="res://scenes_and_scripts/dialog/story portraits/MARTYDAVID.png" id="4_md"]
[ext_resource type="Texture2D" uid="uid://bxae32ssg3a6o" path="res://scenes_and_scripts/dialog/story portraits/DOCTOR_METCALF.png" id="5_doctor"]
