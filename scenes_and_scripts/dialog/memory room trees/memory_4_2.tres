[sub_resource type="Resource" id="Resource_beat_1"]
script = ExtResource("2_beat")
speaker = 6
text = "Oh look, he finally did it. That makes you the champion of RCProAm. The crowd loves it.
Uh oh. Someone isn't impressed."
portrait = ExtResource("4_grandpa")
portrait_side = 1
central_image = ExtResource("3_icon")

[sub_resource type="Resource" id="Resource_beat_2"]
script = ExtResource("2_beat")
text = "Maybe because someone can do better."
portrait = ExtResource("5_md")
central_image = ExtResource("3_icon")

[sub_resource type="Resource" id="Resource_beat_3"]
script = ExtResource("2_beat")
speaker = 6
text = "Well then, pass him the controller. Let's see what he's got."
portrait_side = 1
central_image = ExtResource("3_icon")

[sub_resource type="Resource" id="Resource_beat_4"]
script = ExtResource("2_beat")
text = "Sometimes you have to slow down to go fast. See? I'm catching up now..."
central_image = ExtResource("3_icon")

[sub_resource type="Resource" id="Resource_beat_5"]
script = ExtResource("2_beat")
speaker = 6
text = "He's sliding around the corner with the pack trailing him.  What a rare talent!"
portrait_side = 1
central_image = ExtResource("3_icon")

[sub_resource type="Resource" id="Resource_beat_6"]
script = ExtResource("2_beat")
text = "If you're not first...you're last."
central_image = ExtResource("3_icon")

[sub_resource type="Resource" id="Resource_beat_7"]
script = ExtResource("2_beat")
speaker = 6
text = "As much as you two crash...I am glad you only race in a video game!"
portrait_side = 1
central_image = ExtResource("3_icon")

